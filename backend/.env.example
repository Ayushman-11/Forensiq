# Forensiq Backend Configuration Environment Variables

# App Environment
FORENSIQ_ENV=development
FORENSIQ_DEBUG=true
FORENSIQ_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
# Optional: previous secret key accepted for 1 TTL during key rotation
# FORENSIQ_PREVIOUS_SECRET_KEY=old-super-secret-key-that-was-rotated-recently

# Optional: Path to directory containing mounted secrets (Docker/K8s/Vault secrets mount)
# FORENSIQ_SECRETS_DIR=/run/secrets

# Request body size limit in bytes (defaults to 2MB)
# FORENSIQ_MAX_REQUEST_BODY_BYTES=2097152

# JWT token TTLs (minutes) — defaults: access=30, refresh=10080 (7d)

# Splunk Configuration
FORENSIQ_SPLUNK_URL=https://localhost:8089
FORENSIQ_SPLUNK_USERNAME=admin
FORENSIQ_SPLUNK_PASSWORD=ChangedPassword123!
# TLS verification defaults to true. Set to false only for local dev with self-signed certs.
FORENSIQ_SPLUNK_VERIFY_SSL=false
# Optional: path to a custom CA bundle PEM for Splunk TLS (leave blank to use system CAs)
# FORENSIQ_SPLUNK_CA_BUNDLE=/etc/ssl/certs/splunk-ca.pem
FORENSIQ_SPLUNK_DEFAULT_INDEX=main
FORENSIQ_SPLUNK_ALLOWED_INDEXES=["windows"]

# MongoDB Configuration
FORENSIQ_MONGO_URI=mongodb://localhost:27017
FORENSIQ_MONGO_DB_NAME=forensiq

# Redis Configuration
FORENSIQ_REDIS_URL=redis://localhost:6379/0

# CORS Configuration
FORENSIQ_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Trusted Hosts — set to your domain(s) in production (e.g. ["forensiq.example.com"])
# FORENSIQ_TRUSTED_HOSTS=["*"]

# Grok / xAI LLM Configuration
FORENSIQ_XAI_API_KEY=xai-your-api-key-here
FORENSIQ_XAI_BASE_URL=https://api.x.ai/v1
FORENSIQ_XAI_MODEL=grok-beta

# Threat Intel API Keys (the unprefixed names VT_API_KEY / ABUSEIPDB_API_KEY / XAI_API_KEY also work;
# the FORENSIQ_ prefixed name wins if both are set)
FORENSIQ_ABUSEIPDB_API_KEY=
FORENSIQ_VT_API_KEY=

# Ingestion pipeline (defaults shown)
FORENSIQ_INGEST_OVERLAP_SECONDS=120
FORENSIQ_INGEST_INITIAL_LOOKBACK_HOURS=720
FORENSIQ_INGEST_MAX_PAGES=20
FORENSIQ_INGEST_PAGE_SIZE=500
FORENSIQ_BRUTE_FORCE_THRESHOLD=5

# API Rate Limiting (per-user sliding window)
# FORENSIQ_RATE_LIMIT_SEARCH_MAX=30
# FORENSIQ_RATE_LIMIT_SEARCH_WINDOW=60
# FORENSIQ_RATE_LIMIT_INVESTIGATE_MAX=10
# FORENSIQ_RATE_LIMIT_INVESTIGATE_WINDOW=60
# FORENSIQ_RATE_LIMIT_REPORT_MAX=10
# FORENSIQ_RATE_LIMIT_REPORT_WINDOW=60
# FORENSIQ_RATE_LIMIT_BULK_MAX=15
# FORENSIQ_RATE_LIMIT_BULK_WINDOW=60

# --- Case management (production-readiness 2.4) ---
# FORENSIQ_SLA_SWEEP_INTERVAL_SECONDS=60
# FORENSIQ_TICKET_SYNC_INTERVAL_SECONDS=300
# Jira Cloud ticketing (all four needed; project key only to create tickets)
# FORENSIQ_JIRA_BASE_URL=https://your-org.atlassian.net
# FORENSIQ_JIRA_EMAIL=bot@your-org.com
# FORENSIQ_JIRA_API_TOKEN=
# FORENSIQ_JIRA_PROJECT_KEY=SEC
# FORENSIQ_JIRA_ISSUE_TYPE=Task
# ServiceNow ticketing
# FORENSIQ_SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# FORENSIQ_SERVICENOW_USER=
# FORENSIQ_SERVICENOW_PASSWORD=

# --- Response actions (production-readiness 2.5) ---
# Live execution is OFF unless you set this to true. Dry runs always work.
# FORENSIQ_RESPONSE_LIVE_EXECUTION_ENABLED=false
# FORENSIQ_RESPONSE_REQUEST_TTL_HOURS=24
# FORENSIQ_RESPONSE_APPROVAL_TTL_MINUTES=60
# FORENSIQ_RESPONSE_MAX_LIVE_PER_HOUR=10
# Never actionable: domain controllers, break-glass accounts, gateways (comma separated)
# FORENSIQ_RESPONSE_PROTECTED_TARGETS=dc01,dc02,breakglass@corp.example,10.0.0.1
# CrowdStrike Falcon (API client with Hosts: write)
# FORENSIQ_CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
# FORENSIQ_CROWDSTRIKE_CLIENT_ID=
# FORENSIQ_CROWDSTRIKE_CLIENT_SECRET=
# Okta (API token allowed to suspend users)
# FORENSIQ_OKTA_BASE_URL=https://your-org.okta.com
# FORENSIQ_OKTA_API_TOKEN=
# Firewall automation gateway (receives {"action":"block|unblock","indicator":ip,...})
# FORENSIQ_FIREWALL_WEBHOOK_URL=https://fw-gateway.internal/forensiq
# FORENSIQ_FIREWALL_WEBHOOK_TOKEN=

# --- Multi-tenancy (production-readiness 2.6) ---
# Admins of this tenant can create/suspend other tenants. Everyone else only ever sees their own.
# FORENSIQ_PLATFORM_ORG_ID=default
# Fernet key for per-tenant secrets at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to derive it from FORENSIQ_SECRET_KEY (keep FORENSIQ_PREVIOUS_SECRET_KEY set during a rotation).
# FORENSIQ_TENANT_SECRETS_KEY=
# FORENSIQ_TENANT_USE_PLATFORM_THREAT_INTEL=true
# FORENSIQ_POLLER_TENANT_CONCURRENCY=5

# --- Integrations (production-readiness 2.7) ---
# Optional threat-intel feeds (a tenant can set its own on the Tenants page; these are the platform defaults)
# FORENSIQ_OTX_API_KEY=
# FORENSIQ_OTX_MALICIOUS_MIN_PULSES=5
# FORENSIQ_OTX_SUSPICIOUS_MIN_PULSES=1
# FORENSIQ_GREYNOISE_API_KEY=
# FORENSIQ_MISP_URL=https://misp.example.com
# FORENSIQ_MISP_API_KEY=
# FORENSIQ_MISP_VERIFY_SSL=true
# Elastic is chosen per tenant in the UI (SIEM product = Elastic); there are no platform-wide Elastic settings.
