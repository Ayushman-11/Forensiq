# Forensiq Backend Configuration Environment Variables

# App Environment
FORENSIQ_ENV=development
FORENSIQ_DEBUG=true
FORENSIQ_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long

# JWT token TTLs (minutes) — defaults: access=1440 (24h), refresh=10080 (7d)

# Splunk Configuration
FORENSIQ_SPLUNK_URL=https://localhost:8089
FORENSIQ_SPLUNK_USERNAME=admin
FORENSIQ_SPLUNK_PASSWORD=ChangedPassword123!
FORENSIQ_SPLUNK_VERIFY_SSL=false
FORENSIQ_SPLUNK_DEFAULT_INDEX=main

# MongoDB Configuration
FORENSIQ_MONGO_URI=mongodb://localhost:27017
FORENSIQ_MONGO_DB_NAME=forensiq

# Redis Configuration
FORENSIQ_REDIS_URL=redis://localhost:6379/0

# CORS Configuration
FORENSIQ_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Grok / xAI LLM Configuration
FORENSIQ_XAI_API_KEY=xai-your-api-key-here
FORENSIQ_XAI_BASE_URL=https://api.x.ai/v1
FORENSIQ_XAI_MODEL=grok-beta

# Threat Intel API Keys
FORENSIQ_ABUSEIPDB_API_KEY=

# Ingestion pipeline (defaults shown)
FORENSIQ_INGEST_OVERLAP_SECONDS=120
FORENSIQ_INGEST_MAX_PAGES=20
FORENSIQ_INGEST_PAGE_SIZE=500
FORENSIQ_BRUTE_FORCE_THRESHOLD=5
FORENSIQ_VT_API_KEY=
