# Forensiq Backend Configuration Environment Variables

# App Environment
FORENSIQ_ENV=development
FORENSIQ_DEBUG=true
FORENSIQ_SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
# Optional: previous secret key accepted for 1 TTL during key rotation
# FORENSIQ_PREVIOUS_SECRET_KEY=old-super-secret-key-that-was-rotated-recently

# Optional: Path to directory containing mounted secrets (Docker/K8s/Vault secrets mount)
# FORENSIQ_SECRETS_DIR=/run/secrets

# Request body size limit in bytes (defaults to 2MB)
# FORENSIQ_MAX_REQUEST_BODY_BYTES=2097152

# JWT token TTLs (minutes) — defaults: access=30, refresh=10080 (7d)

# Splunk Configuration
FORENSIQ_SPLUNK_URL=https://localhost:8089
FORENSIQ_SPLUNK_USERNAME=admin
FORENSIQ_SPLUNK_PASSWORD=ChangedPassword123!
# TLS verification defaults to true. Set to false only for local dev with self-signed certs.
FORENSIQ_SPLUNK_VERIFY_SSL=false
# Optional: path to a custom CA bundle PEM for Splunk TLS (leave blank to use system CAs)
# FORENSIQ_SPLUNK_CA_BUNDLE=/etc/ssl/certs/splunk-ca.pem
FORENSIQ_SPLUNK_DEFAULT_INDEX=main
FORENSIQ_SPLUNK_ALLOWED_INDEXES=["windows"]

# MongoDB Configuration
FORENSIQ_MONGO_URI=mongodb://localhost:27017
FORENSIQ_MONGO_DB_NAME=forensiq

# Redis Configuration
FORENSIQ_REDIS_URL=redis://localhost:6379/0

# CORS Configuration
FORENSIQ_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Trusted Hosts — set to your domain(s) in production (e.g. ["forensiq.example.com"])
# FORENSIQ_TRUSTED_HOSTS=["*"]

# Grok / xAI LLM Configuration
FORENSIQ_XAI_API_KEY=xai-your-api-key-here
FORENSIQ_XAI_BASE_URL=https://api.x.ai/v1
FORENSIQ_XAI_MODEL=grok-beta

# Threat Intel API Keys
FORENSIQ_ABUSEIPDB_API_KEY=
FORENSIQ_VT_API_KEY=

# Ingestion pipeline (defaults shown)
FORENSIQ_INGEST_OVERLAP_SECONDS=120
FORENSIQ_INGEST_MAX_PAGES=20
FORENSIQ_INGEST_PAGE_SIZE=500
FORENSIQ_BRUTE_FORCE_THRESHOLD=5

# API Rate Limiting (per-user sliding window)
# FORENSIQ_RATE_LIMIT_SEARCH_MAX=30
# FORENSIQ_RATE_LIMIT_SEARCH_WINDOW=60
# FORENSIQ_RATE_LIMIT_INVESTIGATE_MAX=10
# FORENSIQ_RATE_LIMIT_INVESTIGATE_WINDOW=60
# FORENSIQ_RATE_LIMIT_REPORT_MAX=10
# FORENSIQ_RATE_LIMIT_REPORT_WINDOW=60
# FORENSIQ_RATE_LIMIT_BULK_MAX=15
# FORENSIQ_RATE_LIMIT_BULK_WINDOW=60
